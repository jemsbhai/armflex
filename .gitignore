*.gguf

# Experiment outputs (results and configs are committed selectively by hand)
experiments/*/checkpoints/
experiments/*/logs/
experiments/*/raw/
runs/

# LaTeX build artifacts (compiled figures and final PDFs are handled by hand)
papers/**/*.aux
papers/**/*.log
papers/**/*.out
papers/**/*.bbl
papers/**/*.blg
papers/**/*.synctex.gz
papers/**/*.fls
papers/**/*.fdb_latexmk

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
